rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ユーザー認証の有無を判定
    function isAuthenticated() {
      return request.auth != null;
    }

    // グループコレクションのセキュリティルール
    match /groups/{groupId} {
      // 招待コード検索・参加のため、認証済みユーザーはグループ一覧の読み取りが可能
      allow read: if isAuthenticated();

      // グループ作成: 作成者が自分自身を ownerUid および memberUids に含めていること
      allow create: if isAuthenticated() &&
                    request.resource.data.ownerUid == request.auth.uid &&
                    request.auth.uid in request.resource.data.memberUids;

      // グループ更新: メンバーであるか、または招待コードにより自分を memberUids に追加する場合
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.memberUids ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) &&
        request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
        request.auth.uid in request.resource.data.memberUids
      );

      // グループ削除: オーナーのみ
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // グループ配下の訪問地点・思い出（サブコレクションまたは紐付きデータ用）
      match /pins/{pinId} {
        allow read, write: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
      }
    }

    // デフォルトはすべてのアクセスを遮断
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
