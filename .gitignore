# ==============================================================================
# 1. Secrets, API Keys & Credentials (NEVER COMMIT)
# ==============================================================================
# Environment variable files
.env
.env.*
!.env.example
!.env.sample

# Google Cloud / Firebase service account & private keys
*service-account*.json
*service_account*.json
*credentials*.json
*.pem
*.p12
*.key
*.keystore
*.jks

# Mobile platform local & signing secrets (Google Maps API keys, keystore paths, etc.)
local.properties
**/android/local.properties
**/android/key.properties
**/ios/Flutter/Secrets.xcconfig
**/ios/Runner/Secrets.xcconfig
**/ios/Runner/ApiKeys.plist
Secrets.plist

# ==============================================================================
