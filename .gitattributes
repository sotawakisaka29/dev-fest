# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF for Dart files
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
